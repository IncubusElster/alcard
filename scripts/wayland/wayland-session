#!/bin/sh
# Optional labwc session launched after greetd/PAM authentication.
# No sudo, no GTK services, no fallback to insecure /tmp runtime directories.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
[ "$#" -eq 0 ] || { echo 'This login target takes no arguments' >&2; exit 1; }
[ "$(id -u)" -ne 0 ] || { echo "Wayland must run as a user" >&2; exit 1; }
[ -x /usr/bin/labwc ] || { echo "labwc is not installed" >&2; exit 1; }
command -v dbus-run-session >/dev/null 2>&1 ||
    { echo "dbus-run-session is missing" >&2; exit 1; }
[ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ ! -L "$XDG_RUNTIME_DIR" ] ||
    { echo "Missing XDG_RUNTIME_DIR; check greetd/PAM/elogind" >&2; exit 1; }
[ "$(stat -c %u "$XDG_RUNTIME_DIR")" = "$(id -u)" ] ||
    { echo "XDG_RUNTIME_DIR is not owned by the session user" >&2; exit 1; }
[ "$(stat -c %a "$XDG_RUNTIME_DIR")" = 700 ] ||
    { echo "XDG_RUNTIME_DIR must have mode 700" >&2; exit 1; }

# Root-owned values generated by alcard-setupd from a fixed layout enum.
# Never execute user-controlled configuration. No file means standard XKB.
keyboard_env=/etc/alcard/keyboard-xkb.env
if [ -f "$keyboard_env" ]; then
    [ ! -L "$keyboard_env" ] && [ "$(stat -c %u "$keyboard_env")" = 0 ] &&
        [ "$(stat -c %a "$keyboard_env")" = 644 ] ||
        { echo "Invalid owner/permissions for $keyboard_env" >&2; exit 1; }
    # shellcheck disable=SC1091
    . "$keyboard_env"
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc
# The first Alcard Wayland test targets the CPU compositor. GPU is optional.
export WLR_RENDERER=pixman
export LIBSEAT_BACKEND=logind
# No X11 applications in the initial graphical profile.
# The terminal is the session client, not a detached autostart process.
# When Foot exits, labwc terminates too, returning control to greetd/agreety.
exec dbus-run-session -- /usr/bin/labwc --session "/usr/bin/foot --config=/etc/alcard/foot.ini --fullscreen"
